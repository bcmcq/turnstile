{
	frankenphp
}

:8080 {
	root * /app/public
	encode zstd br gzip

	# Mercure hub lives in the same process as the API.
	mercure {
		# Shared-secret JWTs (RFC 7519 style); modern mode needs an issuer block + JWKS, overkill for a demo.
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY}
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
		anonymous
		subscriptions
		cors_origins http://localhost:5173 http://127.0.0.1:5173
		publish_origins *
	}

	php_server
}
