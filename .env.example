# Optional: compose.yaml carries these same defaults. Copy to .env (git-ignored) only to override.
COMPOSE_PROJECT_NAME=turnstile

MYSQL_DATABASE=turnstile
MYSQL_USER=turnstile
MYSQL_PASSWORD=turnstile
MYSQL_ROOT_PASSWORD=root

# Mercure (demo keys; the hub runs inside the api container)
MERCURE_PUBLISHER_JWT_KEY=turnstile-publisher-demo-key-change-me-0123456789
MERCURE_SUBSCRIBER_JWT_KEY=turnstile-subscriber-demo-key-change-me-0123456789

WORKER_SCALE=2

# How densely the arena is seeded on first boot: "demo" (4,280 seats, the design's layout) or "full" (about 49,000,
# the stress-test crowd). Changing it later needs a Reset from the dashboard or `docker compose down -v`.
ARENA_SIZE=demo

# Required on the endpoints that reach the Docker socket or wipe the arena; the dashboard sends it as X-Admin-Token.
ADMIN_TOKEN=turnstile-admin-demo-token

# Ceiling for the + stepper, Auto and the scaler. Each worker is a container: lower this on a small laptop.
# Changing it later: edit, then `docker compose up -d`.
MAX_WORKERS=32
